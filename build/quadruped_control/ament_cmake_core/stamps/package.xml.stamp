<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quadruped_control</name>
  <version>0.0.0</version>
  <description>Basic quadruped crawl movement</description>
  <maintainer email="jonathan.dang@student.unsw.edu.au">jonnydang2004</maintainer>
